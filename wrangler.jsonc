{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-outbox",
  "main": "worker/entry.mjs",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "app.agent-outbox.dev",
      "custom_domain": true
    },
    {
      "pattern": "agent-outbox.dev",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "secrets": {
    "required": [
      "CLERK_SECRET_KEY",
      "SENTRY_DSN",
      "CALLER_KEY_HASH_SECRET",
      "SMOKE_OR_CLEANUP_TOKEN",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "contact@agent-outbox.dev",
      "allowed_sender_addresses": ["contact-form@agent-outbox.dev"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "agent-outbox"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
}

{
  "verifiedAsOf": "2026-08-29",
  "node": {
    "version": "24.18.0",
    "lts": "Krypton",
    "npm": "11.16.0",
    "source": "https://nodejs.org/dist/index.json"
  },
  "go": {
    "version": "1.26.4",
    "source": "https://go.dev/dl/?mode=json"
  },
  "goTooling": {
    "cobra": {
      "module": "github.com/spf13/cobra",
      "version": "1.10.2",
      "source": "https://pkg.go.dev/github.com/spf13/cobra"
    },
    "goreleaser": {
      "module": "github.com/goreleaser/goreleaser/v2",
      "version": "2.16.0",
      "source": "go list -m -json github.com/goreleaser/goreleaser/v2@latest (verified 2026-07-03)"
    },
    "githubActionsSetupGo": {
      "version": "v7",
      "source": "https://github.com/actions/setup-go/releases"
    }
  },
  "packageManager": {
    "name": "pnpm",
    "version": "11.9.0",
    "source": "npm view pnpm version engines --json"
  },
  "flyway": {
    "version": "12.10.0",
    "image": "flyway/flyway",
    "source": "https://documentation.red-gate.com/fd/command-line-277579359.html"
  },
  "phase1Tools": {
    "prettier": {
      "version": "3.9.6",
      "package": "prettier",
      "source": "npm view prettier version engines --json"
    },
    "markdownlint": {
      "version": "0.23.2",
      "package": "markdownlint-cli2",
      "source": "npm view markdownlint-cli2 version engines --json"
    },
    "ignore": {
      "version": "7.0.6",
      "package": "ignore",
      "source": "npm view ignore version engines --json"
    },
    "typescript": {
      "version": "6.0.3",
      "package": "typescript",
      "source": "npm view typescript version engines --json"
    },
    "nodeTypes": {
      "version": "24.13.3",
      "package": "@types/node",
      "source": "corepack pnpm view @types/node@24 version --json"
    },
    "testRunner": {
      "name": "node --test",
      "version": "24.18.0",
      "source": "Pinned by the Node runtime."
    },
    "buildTooling": {
      "name": "tsc plus scripts/foundation.mjs",
      "version": "6.0.3",
      "source": "Pinned by TypeScript and this repository."
    }
  },
  "runtimePins": {
    "next": {
      "version": "16.3.3",
      "package": "next",
      "source": "npm view next version engines peerDependencies --json"
    },
    "react": {
      "version": "19.2.8",
      "package": "react",
      "source": "npm view react version --json"
    },
    "reactDom": {
      "version": "19.2.8",
      "package": "react-dom",
      "source": "npm view react-dom version --json"
    },
    "clerkNextjs": {
      "version": "7.8.2",
      "package": "@clerk/nextjs",
      "source": "npm view @clerk/nextjs version engines peerDependencies --json"
    },
    "supabaseJs": {
      "version": "2.112.4",
      "package": "@supabase/supabase-js",
      "source": "npm view @supabase/supabase-js version engines --json"
    },
    "sentryNextjs": {
      "version": "10.71.0",
      "package": "@sentry/nextjs",
      "source": "npm view @sentry/nextjs version engines peerDependencies --json"
    },
    "lucideReact": {
      "version": "1.34.0",
      "package": "lucide-react",
      "source": "corepack pnpm view lucide-react version"
    },
    "sonner": {
      "version": "2.0.8",
      "package": "sonner",
      "source": "corepack pnpm view sonner version dist-tags --json"
    },
    "postgresNode": {
      "version": "8.23.0",
      "package": "pg",
      "source": "npm view pg version engines --json"
    },
    "postgresCloudflare": {
      "version": "1.4.0",
      "package": "pg-cloudflare",
      "source": "corepack pnpm view pg-cloudflare version --json"
    },
    "stripeNode": {
      "version": "22.5.0",
      "package": "stripe",
      "source": "npm view stripe version engines --json"
    },
    "marked": {
      "version": "18.0.11",
      "package": "marked",
      "source": "corepack pnpm view marked version engines --json"
    },
    "typebox": {
      "version": "1.3.19",
      "package": "typebox",
      "source": "corepack pnpm view typebox version engines --json"
    }
  },
  "runtimeDevTools": {
    "reactTypes": {
      "version": "19.2.18",
      "package": "@types/react",
      "source": "corepack pnpm view @types/react@19 version --json"
    },
    "reactDomTypes": {
      "version": "19.2.5",
      "package": "@types/react-dom",
      "source": "corepack pnpm view @types/react-dom@19 version --json"
    },
    "postgresTypes": {
      "version": "8.23.1",
      "package": "@types/pg",
      "source": "corepack pnpm view @types/pg@8 version --json"
    },
    "playwrightTest": {
      "version": "1.61.1",
      "package": "@playwright/test",
      "source": "corepack pnpm view @playwright/test version"
    },
    "sharp": {
      "version": "0.35.4",
      "package": "sharp",
      "source": "corepack pnpm view sharp version engines --json"
    },
    "cloudflareOpenNext": {
      "version": "1.20.4",
      "package": "@opennextjs/cloudflare",
      "source": "pnpm view @opennextjs/cloudflare version engines peerDependencies bin --json"
    },
    "cloudflareRclonePeer": {
      "version": "0.6.6",
      "package": "rclone.js",
      "source": "pnpm view rclone.js version engines --json"
    },
    "tsx": {
      "version": "4.23.12",
      "package": "tsx",
      "source": "corepack pnpm view tsx version engines --json"
    }
  },
  "providerCli": {
    "cloudflareWrangler": {
      "version": "4.126.0",
      "package": "wrangler",
      "source": "pnpm view wrangler version engines --json",
      "authCheck": ["wrangler", "whoami", "--env-file", "/dev/null"]
    },
    "clerk": {
      "version": "3.2.0",
      "package": "clerk",
      "source": "npm view clerk name version description bin homepage repository engines --json",
      "authCheck": ["clerk", "whoami", "--json"]
    },
    "supabase": {
      "version": "2.115.0",
      "package": "supabase",
      "source": "npm view supabase version --json",
      "authCheck": ["supabase", "projects", "list", "--output", "json"]
    },
    "stripe": {
      "version": "1.43.2",
      "package": null,
      "source": "https://api.github.com/repos/stripe/stripe-cli/releases/latest",
      "authCheck": ["stripe", "whoami", "--format", "json"]
    },
    "sentry": {
      "version": "3.6.2",
      "package": "@sentry/cli",
      "source": "npm view @sentry/cli version engines --json",
      "authCheck": ["sentry-cli", "info", "--no-defaults"]
    }
  }
}

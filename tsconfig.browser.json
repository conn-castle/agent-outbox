{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": ".next-browser/tsconfig.tsbuildinfo"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "instrumentation.ts",
    "playwright.config.ts",
    "types/**/*.d.ts",
    "next.config.ts",
    "middleware.ts",
    "scripts/**/*.mjs",
    "sentry.edge.config.ts",
    "sentry.server.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.mjs",
    "tests/**/*.ts",
    ".next-browser/types/**/*.ts",
    ".next-browser/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}

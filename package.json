{
  "name": "agent-outbox",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "Hosted human-review queue and CLI for agent-prepared work.",
  "license": "PolyForm-Perimeter-1.0.1",
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "setup": "corepack install -g --cache-only pnpm@11.9.0 && corepack pnpm install --frozen-lockfile",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:database": "node --test --test-concurrency=1 tests/*.test.mjs",
    "browser": "playwright test",
    "release:preflight": "node scripts/release-version.mjs",
    "marketing": "node scripts/marketing-screenshots.mjs capture",
    "marketing:check": "node scripts/marketing-screenshots.mjs check",
    "marketing:verify": "node scripts/marketing-screenshots.mjs verify",
    "next:build": "next build",
    "worker:build": "opennextjs-cloudflare build",
    "worker:dry-run": "corepack pnpm run worker:build && wrangler deploy --dry-run --env-file /dev/null",
    "worker:deploy": "node scripts/worker-deploy.mjs",
    "smoke": "node scripts/foundation.mjs smoke",
    "contract:generate": "node scripts/system-contract.mjs generate",
    "contract:check": "node scripts/system-contract.mjs check",
    "smoke-runtime": "node scripts/runtime-smoke.mjs",
    "hosted-health": "node scripts/hosted-health.mjs",
    "billing-smoke": "node scripts/billing-smoke.mjs",
    "docs:generate": "tsx scripts/api-docs.ts generate",
    "docs:check": "tsx scripts/api-docs.ts check",
    "migration:validate": "node scripts/flyway.mjs validate",
    "migration:validate-pre-migrate": "node scripts/flyway.mjs validate --ignore-pending",
    "migration:migrate": "node scripts/flyway.mjs migrate",
    "migration:replay": "corepack pnpm run migration:validate-pre-migrate && corepack pnpm run migration:migrate && corepack pnpm run migration:validate",
    "cloudflare:ratelimit": "node scripts/run-with-ssm-secrets.mjs --set cloudflare-ratelimit-production -- node scripts/cloudflare-ratelimit.mjs",
    "sentry": "node scripts/run-with-ssm-secrets.mjs --set sentry-production -- sentry-cli",
    "build": "corepack pnpm run docs:check && node scripts/foundation.mjs build && corepack pnpm run next:build",
    "doctor": "node scripts/foundation.mjs doctor",
    "check": "corepack pnpm run contract:check && corepack pnpm run docs:check && corepack pnpm run format:check && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run build && corepack pnpm run smoke",
    "release-check": "make release-check",
    "clean": "node scripts/foundation.mjs clean"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.4",
    "@playwright/test": "1.62.1",
    "@sentry/cli": "3.6.2",
    "@types/node": "24.13.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "clerk": "1.5.0",
    "ignore": "7.0.6",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "rclone.js": "0.6.6",
    "sharp": "0.35.4",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "wrangler": "4.126.0"
  },
  "dependencies": {
    "@clerk/nextjs": "7.8.2",
    "@sentry/nextjs": "10.71.0",
    "@supabase/supabase-js": "2.112.4",
    "lucide-react": "1.23.0",
    "marked": "18.0.11",
    "next": "16.3.3",
    "pg": "8.23.0",
    "pg-cloudflare": "1.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.5.0",
    "typebox": "1.3.19"
  }
}

{
  "name": "agent-outbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Outbox foundation tooling and verification gates.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "setup": "corepack install -g --cache-only pnpm@11.9.0 && corepack pnpm install --frozen-lockfile",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "browser": "playwright test",
    "next:build": "next build",
    "worker:build": "opennextjs-cloudflare build",
    "worker:dry-run": "pnpm run worker:build && wrangler deploy --dry-run --env-file /dev/null",
    "worker:deploy": "node scripts/worker-deploy.mjs",
    "smoke": "node scripts/foundation.mjs smoke",
    "smoke-runtime": "node scripts/runtime-smoke.mjs",
    "hosted-health": "node scripts/hosted-health.mjs",
    "billing-smoke": "node scripts/billing-smoke.mjs",
    "migration:validate": "node scripts/flyway.mjs validate",
    "migration:validate-pre-migrate": "node scripts/flyway.mjs validate --ignore-pending",
    "migration:migrate": "node scripts/flyway.mjs migrate",
    "migration:replay": "corepack pnpm run migration:validate-pre-migrate && corepack pnpm run migration:migrate && corepack pnpm run migration:validate",
    "build": "node scripts/foundation.mjs build && corepack pnpm run next:build",
    "doctor": "node scripts/foundation.mjs doctor",
    "check": "corepack pnpm run format:check && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run build && corepack pnpm run smoke",
    "release-check": "make release-check",
    "clean": "node scripts/foundation.mjs clean"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "1.61.1",
    "@sentry/cli": "3.6.0",
    "@types/node": "24.13.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "clerk": "1.5.0",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.9.3",
    "rclone.js": "0.6.6",
    "supabase": "2.108.0",
    "typescript": "6.0.3",
    "wrangler": "4.107.0"
  },
  "dependencies": {
    "@clerk/nextjs": "7.5.10",
    "@sentry/nextjs": "10.62.0",
    "@supabase/supabase-js": "2.108.2",
    "lucide-react": "1.23.0",
    "next": "16.2.9",
    "pg": "8.22.0",
    "pg-cloudflare": "1.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.3.0"
  }
}

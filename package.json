{
  "name": "agent-outbox",
  "version": "0.0.0",
  "private": true,
  "description": "Agent Outbox foundation tooling and verification gates.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.9.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "setup": "corepack install && pnpm install --frozen-lockfile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/foundation.mjs build",
    "smoke": "node scripts/foundation.mjs smoke",
    "doctor": "node scripts/foundation.mjs doctor",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke",
    "release-check": "pnpm run check",
    "clean": "node scripts/foundation.mjs clean"
  },
  "devDependencies": {
    "@sentry/cli": "3.6.0",
    "@types/node": "24.13.2",
    "clerk": "1.5.0",
    "markdownlint-cli2": "0.22.1",
    "prettier": "3.9.3",
    "supabase": "2.108.0",
    "typescript": "6.0.3",
    "wrangler": "4.105.0"
  }
}

# Agent Outbox local environment template.
# Copy to .env for local development. Do not commit .env.

# App
APP_ENV=development
PORT=38000
APP_BASE_URL=http://localhost:38000
PUBLIC_APP_BASE_URL=http://localhost:38000

# Infrastructure
AWS_PROFILE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_NAMESERVERS=
CLOUDFLARE_DNS_API_TOKEN=
CLOUDFLARE_WORKERS_DEPLOY_API_TOKEN=
CLOUDFLARE_TOKEN_MANAGEMENT_API_TOKEN=
CLOUDFLARE_WAF_API_TOKEN=

# Supabase / Postgres
SUPABASE_PROJECT_REF=
DATABASE_URL=
DATABASE_APP_ROLE_URL=
DATABASE_MIGRATION_URL=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Stripe
STRIPE_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAID_MONTHLY_PRICE_ID=
STRIPE_PAID_YEARLY_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Sentry
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
AGENT_OUTBOX_SENTRY_RELEASE_UPLOAD=
AGENT_OUTBOX_SENTRY_DEPLOY_RELEASE_PATH=

# Cloudflare Web Analytics
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# Agent Outbox CLI
# Optional app/API origin for CLI commands.
# Precedence: --base-url, AGENT_OUTBOX_BASE_URL, local CLI config, hosted default.
AGENT_OUTBOX_BASE_URL=
# Optional local config file path for CLI commands.
# Precedence: --config, AGENT_OUTBOX_CONFIG_PATH, platform-standard config path.
AGENT_OUTBOX_CONFIG_PATH=
# Optional local caller selector for caller-owned CLI commands.
# Precedence: --caller, AGENT_OUTBOX_CALLER, single local caller.
AGENT_OUTBOX_CALLER=

# Agent Outbox internals
CALLER_KEY_HASH_SECRET=
SMOKE_OR_CLEANUP_TOKEN=

# Agent Outbox local environment template.
# Copy to .env for local development. Do not commit .env.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_APP_BASE_URL=http://localhost:3000

# Supabase / Postgres
DATABASE_URL=
DATABASE_APP_ROLE_URL=
DATABASE_MIGRATION_URL=

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAID_MONTHLY_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Sentry
SENTRY_DSN=
SENTRY_BROWSER_DSN=
SENTRY_AUTH_TOKEN=

# Agent Outbox internals
CALLER_KEY_HASH_SECRET=
SMOKE_OR_CLEANUP_TOKEN=
